{
  "name": "<site name> Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "imagemagick,librsvg2-bin"
    }
  },
  "mounts": [
        {
      "source": "${localEnv:HOME}/dev-config/codex",
      "target": "/home/vscode/.codex",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/dev-config/agent-browser",
      "target": "/home/vscode/.agent-browser",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/dev-config/agents",
      "target": "/home/vscode/.agents",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}/dev-config/mnemonic",
      "target": "/home/vscode/.mnemonic",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        // Data and formats
        "redhat.vscode-yaml",

        // Markdown and documentation
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",

        //Stack
        "ms-vscode.vscode-typescript-next",
        "bradlc.vscode-tailwindcss",
        "astro-build.astro-vscode",

        // General productivity
        "Gruntfuggly.todo-tree",
        "eamodio.gitlens",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",

        // AI assistants
        "openai.chatgpt"
      ],
      "settings": {}
    }
  },

  "remoteEnv": {},

  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro App",
      "onAutoForward": "openBrowser"
    }
  },

  "postCreateCommand": {
    "own-cache": "mkdir -p /home/vscode/.cache && sudo chown -R vscode:vscode /home/vscode/.cache",
    "task": "npm install -g @go-task/cli",
    "codex": "npm i -g @openai/codex",
    "skills": "npx -y skills list"
  }
}
