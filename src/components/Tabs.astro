---
import WindowTitle from './WindowTitle.astro';
interface Props { labels: string[]; name: string; folder?: boolean; }
const { labels, name, folder = false } = Astro.props;
---
<div class:list={["tabs", { "folder-tabs": folder }]} data-tabs>
  <div class:list={[folder ? "folder-window window light-window" : "tab-selector"]}>
  {folder && <><WindowTitle title="Projects — File Explorer" /><div class="folder-address"><span aria-hidden="true">▱</span><span>Desktop <span aria-hidden="true">/</span> <strong>Projects</strong></span></div><div class="folder-info"><span>{labels.length} projects</span><span>Select a folder to open</span></div></>}
  <div class="tab-list" aria-label={name}>
    {labels.map((label, i) => <a id={`tab-${i}`} href={`#panel-${i}`} data-tab>{folder && <span class="project-folder-icon" aria-hidden="true"><span></span></span>}<span>{label}</span></a>)}
  </div>
  </div>
  <div class="tab-content"><slot /></div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(root => {
    const list = root.querySelector<HTMLElement>('.tab-list')!;
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    list.setAttribute('role', 'tablist');
    list.setAttribute('aria-orientation', 'horizontal');
    function select(index: number) {
      tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; panels[i].hidden = i !== index; });
    }
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab'); tab.setAttribute('aria-controls', panels[i].id);
      panels[i].setAttribute('role', 'tabpanel'); panels[i].setAttribute('aria-labelledby', tab.id); panels[i].tabIndex = 0;
      tab.addEventListener('click', e => { e.preventDefault(); select(i); });
      tab.addEventListener('keydown', e => {
        let next = i;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        else return;
        e.preventDefault(); select(next); tabs[next].focus();
      });
    });
    select(0);
  });
</script>
