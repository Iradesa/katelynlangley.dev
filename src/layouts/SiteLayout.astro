---
import '../styles/global.css';
const { title = 'Katelyn Langley, Software Developer', description = 'Projects, games, and software made by Katelyn Langley.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#704da0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-[#cbb8e8] font-mono text-[#baff70]"><slot /></body>
</html>
