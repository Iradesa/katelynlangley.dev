---
import Desktop from '../layouts/Desktop.astro';
import ContactIcon from '../components/ContactIcon.astro';
import WindowTitle from '../components/WindowTitle.astro';
import ChatText from '../components/ChatText.astro';
const education='My path started with a B.S. in Computer Systems, focused on Game Development, from California State University of San Bernardino. I followed it with Google’s UX/UI Design Certificate, and I’m still adding new languages and software skills through Boot.dev.';
---
<Desktop page="Bio" description="About Katelyn Langley, junior software developer, and ways to get in touch.">
<div class="open-windows bio-workspace">
<section class="window dark-window"><WindowTitle title="about-katelyn-langley.txt" /><div class="window-body">
<p class="eyebrow">A LITTLE ABOUT ME</p><h1>Hello! <span class="greeting">(ᵔᵕᵔ)ﾉ</span></h1>
<ChatText room="about-me"><p class="prose">My name is Katelyn Langley, and I'm a Junior Software Developer currently searching for full-time work while I do personal projects on the side. Most of what I know has come from making: trying an idea, getting stuck, finding a way through, and carrying that lesson into whatever I build next. Feel free to check out the projects showcased here and continue to follow this site as I continue to make and publish more projects in the future. Also consider reaching out to me using the button below to discuss anything about my work and future as a developer!</p><p class="prose">{education}</p></ChatText>
</div></section>
<section class="window light-window contact-phone" aria-label="Contact messenger phone">
<div class="phone-hardware" aria-hidden="true"><span class="phone-speaker"></span><span class="phone-camera"></span></div>
<div class="phone-brand" aria-hidden="true">POCKET MESSENGER</div>
<div class="phone-screen">
<div class="phone-status" aria-hidden="true"><span>▂▄▆ connected</span><span>✉ 1 <span class="phone-battery"></span></span></div>
<div class="phone-app-title">contact.messenger</div>
<div class="phone-home">
<div class="incoming-text"><p class="incoming-text-label">New text message</p><div class="text-bubble"><h2>Come say hello.</h2><p>Get in touch about my work and future as a developer, or explore what I’m making.</p></div></div>
<p class="phone-apps-label">MY APPS</p>
<nav class="phone-apps" aria-label="Contact apps">
<a href="mailto:me@katelynlangley.dev" aria-label="Email me@katelynlangley.dev" title="me@katelynlangley.dev"><span class="phone-app-icon email-app"><ContactIcon name="email" /></span><span>Email</span></a>
<a href="https://github.com/Iradesa" aria-label="GitHub — Iradesa"><span class="phone-app-icon github-app"><ContactIcon name="github" /></span><span>GitHub</span></a>
<a href="https://iradesa.itch.io" aria-label="itch.io — iradesa"><span class="phone-app-icon itch-app"><ContactIcon name="itchdotio" /></span><span>itch.io</span></a>
</nav>
</div>
<div class="phone-softkeys" aria-hidden="true"><span>Messages</span><span>Contacts</span></div>
</div>
<div class="phone-keypad" aria-hidden="true"><span class="phone-call">⌕</span><span class="phone-dpad"><i></i></span><span class="phone-end">⏻</span></div>
</section>
</div>
</Desktop>
