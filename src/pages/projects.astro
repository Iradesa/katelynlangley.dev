---
import Desktop from '../layouts/Desktop.astro';
import ChatText from '../components/ChatText.astro';
import Tabs from '../components/Tabs.astro';
import Placeholder from '../components/Placeholder.astro';
import WindowTitle from '../components/WindowTitle.astro';
import { projects } from '../data/portfolio';
---
<Desktop page="Projects" description="Explore Tavern Playhouse, Cody’s Crayons, and Marion, projects by Katelyn Langley.">
<header class="workspace-heading"><p class="eyebrow">THINGS I’VE MADE</p><h1>Projects</h1><p>Choose a project to open its overview, screenshots, and development notes.</p></header>
<Tabs name="Projects" labels={projects.map(p => p.name)}>{projects.map((p, i) => <div class="open-windows project-workspace" id={`panel-${i}`} data-panel>
<article class="window dark-window"><WindowTitle title={p.file} /><div class="window-body"><p class="eyebrow">PROJECT OVERVIEW</p><h2>{p.name}</h2><ChatText room="project-notes"><p class="prose">{p.note}</p></ChatText><a class="action-link" href={p.url}>{p.name === 'Marion' ? 'View Marion on GitHub' : p.action} ↗</a></div><div class="window-status">Overview · {p.name}</div></article>
<div class="window-stack">
<section class="window light-window"><WindowTitle title="screenshots.viewer" /><div class="window-body"><h3>{p.name} / Screenshots</h3></div><div class="project-images"><img src={p.image} alt={p.alt} width={p.width} height={p.height} />{p.secondaryImage && <img src={p.secondaryImage} alt={p.secondaryAlt} width={p.secondaryWidth} height={p.secondaryHeight} loading="lazy" />}</div><div class="window-body"><Placeholder title="More screenshots" prompt="Add project and development screenshots with captions here." /></div><div class="window-status">Project gallery</div></section>
<section class="window light-window"><WindowTitle title="development-notes.txt" /><div class="window-body"><Placeholder title="Behind the development" prompt="Add development notes, challenges, and what I learned while making this project." /></div></section>
</div></div>)}</Tabs>
</Desktop>
