---
import Desktop from '../layouts/Desktop.astro';
import WindowTitle from '../components/WindowTitle.astro';
import ChatText from '../components/ChatText.astro';
const sections = [
  { title: 'Bio', file: 'about-katelyn.txt', href: '/bio/', description: 'A little about me, my background, and where to find me.' },
  { title: 'Projects', file: 'projects.folder', href: '/projects/', description: 'Games, software, and the stories behind what I’ve made.' },
  { title: 'Skills', file: 'skills.folder', href: '/skills/', description: 'The tools and skills I’m building with and learning along the way.' },
  { title: 'Current work', file: 'current-work.txt', href: '/current-work/', description: 'Substitute teaching and the experience I bring into software development.' },
];
---
<Desktop page="Home" description="Meet Katelyn Langley. Explore my bio, software and game projects, skills, and current work.">
<div class="home-workspace">
<section class="window dark-window welcome"><WindowTitle title="welcome.txt" /><div class="window-body"><p class="eyebrow">JUNIOR SOFTWARE DEVELOPER</p><h1>Katelyn<br />Langley<span class="cursor" aria-hidden="true">_</span></h1><ChatText room="welcome"><p class="prose">Making software, creating games, and always learning something new.</p></ChatText><p class="welcome-note">Welcome to my little corner of the internet.<br />Open a section below to take a look around. ↓</p></div></section>
<div class="section-grid">{sections.map((section, i) => <a class="window section-link light-window" href={section.href}><WindowTitle title={section.file} /><div class="window-body"><span class="eyebrow">0{i + 1}</span><h2>{section.title}</h2><p>{section.description}</p><span class="open-link">Open {section.title.toLowerCase()} →</span></div></a>)}</div>
</div>
</Desktop>
