---
import Desktop from '../layouts/Desktop.astro';
import WindowTitle from '../components/WindowTitle.astro';
import ChatText from '../components/ChatText.astro';
---
<Desktop page="Home" description="Meet Katelyn Langley. Explore my bio, software and game projects, skills, and current work.">
<div class="home-workspace">
<section class="window dark-window welcome"><WindowTitle title="welcome.txt" /><div class="window-body"><p class="eyebrow">JUNIOR SOFTWARE DEVELOPER</p><h1>Katelyn<br />Langley<span class="cursor" aria-hidden="true">_</span></h1><ChatText room="welcome"><p class="prose">Making software, creating games, and always learning something new.</p></ChatText><p class="welcome-note">Welcome to my little corner of the internet.<br />Choose a section from the navigation to take a look around.</p></div></section>

</div>
</Desktop>
